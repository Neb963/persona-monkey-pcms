{
  "name": "persona-monkey-pcms",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate:views": "node tools/generate-views.mjs",
    "verify:views": "node tools/generate-views.mjs --check",
    "verify:claims": "node tools/verify-claims.mjs",
    "verify:repo": "node tools/verify-repo.mjs",
    "test:firefox": "node --test tests/firefox/*.test.mjs",
    "firefox:install": "node tools/firefox/install-pinned.mjs",
    "firefox:smoke": "node tools/firefox/smoke.mjs",
    "verify": "npm run verify:repo && npm run verify:views && npm run verify:claims && npm run test:firefox"
  }
}
